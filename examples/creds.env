# Secrets for errand. Keep this file mode 0600 and out of any repository.
# Pass with `errand-box setup --creds`; setup writes them into errand's
# config (mode 0600) and never prints them.

ERRAND_CHAT_TOKEN=
ERRAND_PROVIDER_CREDENTIAL=
# Optional. This token enters every session as GH_TOKEN: use an account that
# owns nothing of value.
ERRAND_GITHUB_TOKEN=
