#!/bin/sh
# errand-box guest launcher, installed at /usr/local/libexec/errand-box/launch.
#
# The bailey shim on the host writes the session's environment to
# /run/errand-box/env.sh through the Incus API (so no value appears on a host
# command line), then runs this as the guest's root in /workspace:
#   launch <uid> <gid> kage rpc --yolo ...
# It drops to <uid>:<gid> with the account's supplementary groups (incus exec
# --user gives none, so the agent would lose the docker group, E-29), starts
# the command with exactly that environment, deletes the file, and applies
# the file size limit errand asked for. It writes only to stderr: stdout
# carries the agent's protocol.
set -eu
f=/run/errand-box/env.sh
if [ $# -lt 3 ]; then
  echo "errand-box launch: usage: launch <uid> <gid> <command...>" >&2
  exit 125
fi
uid=$1
gid=$2
shift 2
case $uid:$gid in
  *[!0-9:]* | :* | *:) echo "errand-box launch: bad uid or gid: $uid:$gid" >&2; exit 125 ;;
esac
if [ ! -r "$f" ]; then
  echo "errand-box launch: $f is missing; the host did not write the session environment" >&2
  exit 125
fi
# shellcheck disable=SC2016 # the inner script expands its own variables
exec setpriv --reuid="$uid" --regid="$gid" --init-groups -- env -i /bin/sh -c '
  f=$1
  shift
  . "$f"
  rm -f "$f"
  fsize=${EB_FSIZE:-}
  unset EB_FSIZE
  # The broker address is added to lo at boot (errand-box-guest.service).
  # Wait briefly for it so the first request of the agent does not fail.
  i=0
  while [ $i -lt 50 ] && ! ip -4 addr show dev lo 2>/dev/null | grep -q " 169.254.169.1/"; do
    sleep 0.1
    i=$((i + 1))
  done
  if [ -n "$fsize" ]; then
    exec prlimit --fsize="$fsize" -- "$@"
  fi
  exec "$@"
' errand-box-launch "$f" "$@"
